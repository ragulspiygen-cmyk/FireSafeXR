[node name="Mesh" type="MeshInstance3D" parent="Hallway/WallLeft"]
mesh = SubResource("BM_hall_wall")
[node name="Col" type="CollisionShape3D" parent="Hallway/WallLeft"]
shape = SubResource("BS_hall_wall")

[node name="WallRight" type="StaticBody3D" parent="Hallway"]
