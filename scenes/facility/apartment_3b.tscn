[node name="Mesh" type="MeshInstance3D" parent="Hallway/WallRight"]
mesh = SubResource("BM_hall_wall")
[node name="Col" type="CollisionShape3D" parent="Hallway/WallRight"]
shape = SubResource("BS_hall_wall")

; End wall at stairwell entrance (local Z=-4.5 = world Z=-12.5)
[node name="WallEnd" type="StaticBody3D" parent="Hallway"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.5, -4.57)
[node name="Mesh" type="MeshInstance3D" parent="Hallway/WallEnd"]
mesh = SubResource("BM_hall_end")
[node name="Col" type="CollisionShape3D" parent="Hallway/WallEnd"]
shape = SubResource("BS_hall_end")

; Emergency lighting — dim blue-tinted (fire emergency)
[node name="Light1" type="OmniLight3D" parent="Hallway"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 2.6, 2.0)
light_color = Color(0.55, 0.65, 1.0, 1)
light_energy = 0.85
omni_range = 4.2

[node name="Light2" type="OmniLight3D" parent="Hallway"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 2.6, -2.5)
light_color = Color(0.55, 0.65, 1.0, 1)
light_energy = 0.85
omni_range = 4.2

; Exit signs at floor level (per NFPA — smoke rises, signs are low)
[node name="ExitSign1" parent="Hallway" instance=ExtResource("3_exit")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.4, 2.5)

[node name="ExitSign2" parent="Hallway" instance=ExtResource("3_exit")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.4, -1.5)

; Smoke filling the corridor
[node name="Smoke" type="CPUParticles3D" parent="Hallway"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 2.4, 0)
amount = 16
lifetime = 4.0
emission_shape = 1
emission_sphere_radius = 0.9
direction = Vector3(0.1, 0, 0)
spread = 30.0
gravity = Vector3(0, 0.05, 0)
initial_velocity_min = 0.15
initial_velocity_max = 0.45
scale_amount_min = 1.5
scale_amount_max = 4.0

