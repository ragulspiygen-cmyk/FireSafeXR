;  Node3D origin at world (0, 0, -8.0)
; ══════════════════════════════════════════
[node name="Hallway" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -8.0)

[node name="Floor" type="StaticBody3D" parent="Hallway"]
