mesh = SubResource("BM_hall_ceil")
[node name="Col" type="CollisionShape3D" parent="Hallway/Ceiling"]
shape = SubResource("BS_hall_ceil")

[node name="WallLeft" type="StaticBody3D" parent="Hallway"]
